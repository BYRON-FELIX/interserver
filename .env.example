# Copy this file to .env and fill in real values.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Create a Basic Auth token from Pay Hero's API Keys menu; store the token only.
PAYHERO_API_URL=https://backend.payhero.co.ke/api/v2/payments
PAYHERO_AUTH_TOKEN=
PAYHERO_CHANNEL_ID=
PAYHERO_PROVIDER=m-pesa
# Leave blank to use this site's /payments/payhero/callback/ URL.
PAYHERO_CALLBACK_URL=

EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_FALLBACK_KES_PER_USD=130.00

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=
